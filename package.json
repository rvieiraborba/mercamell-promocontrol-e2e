{
  "name": "mercamell-promocontrol-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Testes E2E Playwright/TypeScript para o Mercamell PromoControl",
  "scripts": {
    "setup:app": "node scripts/setup_app.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "engines": { "node": ">=20.11.0" }
}